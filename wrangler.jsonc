{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-web",
  "compatibility_date": "2026-08-17",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "routes": [
    { "pattern": "farissaifuddin.com", "custom_domain": true },
    { "pattern": "www.farissaifuddin.com", "custom_domain": true },
  ],
}
